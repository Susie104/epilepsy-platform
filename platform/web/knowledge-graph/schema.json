      "domain": [
        "Dataset",
        "Model"
      ],
      "range": [
        "DataQualityIssue"
      ],
      "directed": true,
      "causal": false,
      "required_attributes": [
        "source_ids",
        "status"
      ]
    },
    "AFFECTS": {
      "label_zh": "影响对象",
      "domain": [
        "DataQualityIssue"
      ],
      "range": [
        "Dataset",
        "FeatureSet",
        "ResearchVariable",
        "Model",
        "Outcome",
        "Population"
      ],
      "directed": true,
      "causal": false,
      "required_attributes": [
        "source_ids",
        "status"
      ]
    },
