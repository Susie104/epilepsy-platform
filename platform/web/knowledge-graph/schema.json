      "domain": [
        "Dataset"
      ],
      "range": [
        "Population"
      ],
      "directed": true,
      "causal": false,
      "required_attributes": [
        "source_ids",
        "status"
      ]
    },
    "HAS_INDEX_DISEASE": {
