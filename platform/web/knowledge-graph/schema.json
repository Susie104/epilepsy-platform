      ],
      "directed": true,
      "causal": false,
      "required_attributes": [
        "source_ids",
        "status",
        "reason"
      ]
    }
  },
  "provenance_contract": {
    "required_on_clinical_relation": [
      "source_ids",
      "evidence_locator",
      "population",
      "time_condition",
      "status"
    ],
    "status_values": [
      "verified",
      "provisional",
      "disputed",
      "pending",
      "rejected"
    ],
    "causal_claim_default": false
  },
  "relation_semantics": {
    "MODEL_SCORE_PATH": "Model -> ScoreComponent -> ClinicalConcept",
    "MODEL_TO_OUTCOME": "Model -> PREDICTS -> Outcome",
    "MODEL_TO_POPULATION": "Model -> APPLIES_TO -> Population",
    "MODEL_TO_STUDY": "Model -> EVALUATED_IN -> Study",
    "STUDY_TO_POPULATION": "Study -> STUDY_INCLUDES_POPULATION -> Population",
    "D13_PROXY": "ResearchVariable or derived structure -> PROXY_ONLY_FOR -> ClinicalConcept",
    "D13_SELECT_BOUNDARY": "Dataset(D13) -> CANNOT_CALCULATE -> SeLECT model",
    "OUTCOME_BOUNDARY": "data outcome label -> NOT_EQUIVALENT_TO -> strict clinical outcome"
  },
  "mapping_policy": {
    "authoritative_location": "ScoreComponent.properties.d13_mapping_status",
    "allowed_values": [
      "exact_concept",
      "derivable_composite",
      "proxy_only",
      "not_equivalent_proxy",
      "absent"
    ],
    "note": "删除原先6条无状态值且全部指向结局的MAPPING_STATUS_FOR边。"
  },
  "network_data_policy": {
    "provenance_type": "network_public",
    "datasets": [
      "network_dataset_wenzhou_167",
      "network_dataset_suzhou_anhui_149",
      "network_dataset_winder_28"
    ],
    "cannot_combine": true,
    "used_in_d13_training": false
  }
}
