        "Outcome",
        "ClinicalEvent"
      ],
      "directed": true,
      "causal": false,
      "required_attributes": [
        "source_ids",
        "evidence_locator",
        "status"
      ]
    },
    "POSITIVELY_ASSOCIATED_WITH": {
      "label_zh": "正向关联",
      "domain": [
        "ResearchVariable",
        "ClinicalConcept",
