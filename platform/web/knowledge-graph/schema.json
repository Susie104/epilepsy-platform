      "domain": [
        "Outcome",
        "ClinicalEvent"
      ],
      "range": [
        "Population"
      ],
      "directed": true,
      "causal": false,
      "required_attributes": [
        "source_ids",
        "status"
      ]
    },
    "PROXY_FOR": {
      "label_zh": "代理表示",
      "domain": [
        "Outcome"
      ],
      "range": [
        "Disease",
